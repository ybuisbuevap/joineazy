PORT=4000

# Local / Docker Compose: separate variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=joineazy

# Hosted Postgres (Neon, Render, Railway): set this instead and DB_* above is ignored
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=false   # only if your host does not support SSL

JWT_SECRET=change-this-secret-in-production
CORS_ORIGIN=http://localhost:5173
